<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>

<VBox fx:id="drawerRoot"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="nl.siegmann.epublib.viewer.controller.TocController"
      styleClass="toc-drawer"
      prefWidth="350">

    <HBox alignment="CENTER_LEFT" styleClass="toc-header">
        <Label text="Navigation" styleClass="toc-title" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="✕" onAction="#onClose" styleClass="icon-button-small" />
    </HBox>

    <javafx.scene.control.TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <javafx.scene.control.Tab text="Contents">
            <ListView fx:id="tocList" styleClass="toc-list" />
        </javafx.scene.control.Tab>
        <javafx.scene.control.Tab text="Bookmarks">
            <VBox>
                <Button text="+ Add Bookmark" onAction="#onAddBookmark" styleClass="nav-button" maxWidth="Infinity" />
                <ListView fx:id="bookmarkList" styleClass="toc-list" VBox.vgrow="ALWAYS" />
            </VBox>
        </javafx.scene.control.Tab>
    </javafx.scene.control.TabPane>

</VBox>
